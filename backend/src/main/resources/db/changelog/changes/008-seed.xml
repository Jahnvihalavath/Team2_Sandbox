<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">


    <!-- ========================================================= -->
    <!-- Seed counterparties -->
    <!-- ========================================================= -->

    <changeSet id="008-seed-counterparties" author="aadi">

        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM counterparties;
            </sqlCheck>
        </preConditions>


        <loadData
                file="data/counterparties.csv"
                tableName="counterparties"
                separator=","
                relativeToChangelogFile="true">

            <column name="id" type="NUMERIC"/>
            <column name="name" type="STRING"/>
            <column name="lei_code" type="STRING"/>
            <column name="region" type="STRING"/>

        </loadData>


        <rollback>
            <sql>DELETE FROM counterparties;</sql>
        </rollback>

    </changeSet>



    <!-- ========================================================= -->
    <!-- Seed instruments -->
    <!-- ========================================================= -->

    <changeSet id="008-seed-instruments" author="aadi">

        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM instruments;
            </sqlCheck>
        </preConditions>


        <!-- Existing 15 instruments -->
        <loadData
                file="data/instruments.csv"
                tableName="instruments"
                separator=","
                relativeToChangelogFile="true">

            <column name="id" type="NUMERIC"/>
            <column name="symbol" type="STRING"/>
            <column name="name" type="STRING"/>
            <column name="asset_class" type="STRING"/>
            <column name="currency" type="STRING"/>
            <column name="isin" type="STRING"/>

        </loadData>


        <!-- Generate instruments 16-50 -->
        <sql>

            INSERT INTO instruments
            (
                id,
                symbol,
                name,
                asset_class,
                currency,
                isin
            )

            SELECT

                X,

                'GEN' || RIGHT('0000' || CAST(X AS VARCHAR),4),

                'Generated Instrument ' || X,


                CASE MOD(X,5)
                    WHEN 0 THEN 'EQUITY'
                    WHEN 1 THEN 'FIXED_INCOME'
                    WHEN 2 THEN 'FX'
                    WHEN 3 THEN 'COMMODITY'
                    ELSE 'DERIVATIVE'
                END,


                CASE MOD(X,5)
                    WHEN 0 THEN 'USD'
                    WHEN 1 THEN 'EUR'
                    WHEN 2 THEN 'GBP'
                    WHEN 3 THEN 'JPY'
                    ELSE 'CHF'
                END,


                NULL


            FROM SYSTEM_RANGE(16,50);


        </sql>


        <rollback>
            <sql>
                DELETE FROM instruments WHERE id BETWEEN 16 AND 50;
            </sql>
        </rollback>

    </changeSet>



    <!-- ========================================================= -->
    <!-- Seed trades -->
    <!-- ========================================================= -->

    <changeSet id="008-seed-trades" author="aadi">

        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM trades;
            </sqlCheck>
        </preConditions>


        <sql>

            INSERT INTO trades
            (
                trade_ref,
                instrument_id,
                counterparty_id,
                asset_class,
                side,
                quantity,
                price,
                trade_date,
                status
            )

            SELECT

                'TRD-2026-' || RIGHT('000000' || CAST(X AS VARCHAR),6),

                1 + MOD(X,50),

                1 + MOD(X,10),

                'EQUITY',


                CASE
                    WHEN MOD(X,2)=0 THEN 'BUY'
                    ELSE 'SELL'
                END,


                ROUND(RAND()*10000+1,4),

                ROUND(RAND()*500+1,4),


                DATEADD(
                    DAY,
                    MOD(X,120),
                    DATE '2026-04-01'
                ),


                CASE MOD(X,4)
                    WHEN 0 THEN 'PENDING'
                    WHEN 1 THEN 'MATCHED'
                    WHEN 2 THEN 'UNMATCHED'
                    ELSE 'DISPUTED'
                END


            FROM SYSTEM_RANGE(1,500);

        </sql>


        <rollback>
            <sql>
                DELETE FROM trades;
            </sql>
        </rollback>

    </changeSet>



    <!-- ========================================================= -->
    <!-- Seed recon breaks -->
    <!-- ========================================================= -->

    <changeSet id="008-seed-recon-breaks" author="aadi">


        <preConditions onFail="MARK_RAN">

            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM recon_breaks;
            </sqlCheck>

        </preConditions>


        <sql>

            INSERT INTO recon_breaks
            (
                trade_id,
                discrepancy_type,
                status
            )

            SELECT

                id,


                CASE MOD(id,3)
                    WHEN 0 THEN 'PRICE_MISMATCH'
                    WHEN 1 THEN 'QUANTITY_MISMATCH'
                    ELSE 'DATE_MISMATCH'
                END,


                'OPEN'


            FROM trades

            WHERE status IN ('UNMATCHED','DISPUTED')

            LIMIT 30;


        </sql>


        <rollback>
            <sql>
                DELETE FROM recon_breaks;
            </sql>
        </rollback>


    </changeSet>



    <!-- Existing users seed stays here -->


</databaseChangeLog>